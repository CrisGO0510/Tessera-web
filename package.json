{
  "name": "tessera",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.{scss,astro}\"",
    "test": "vitest run",
    "verify": "pnpm check && pnpm lint && pnpm lint:styles && pnpm test",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "build:pages": "pnpm verify && pnpm build && pnpm links",
    "links": "node scripts/check-links.ts dist",
    "e2e": "playwright test",
    "lhci": "CHROME_PATH=\"$(node -p \"require('@playwright/test').chromium.executablePath()\")\" lhci autorun",
    "audit": "pnpm audit --prod --audit-level high",
    "verify:full": "pnpm run audit && pnpm build:pages && pnpm e2e && pnpm lhci"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "happy-dom": "^20.14.5",
    "jiti": "^2.7.0",
    "node-html-parser": "^9.0.4",
    "postcss": "^8.5.28",
    "postcss-html": "^2.0.0",
    "sass": "^1.105.0",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.5",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
