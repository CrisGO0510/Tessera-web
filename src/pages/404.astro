---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe." path="/404" indexable={false}>
  <section class="not-found">
    <span class="not-found__code">404</span>
    <h1 class="not-found__title">Esta página no existe</h1>
    <p class="not-found__text">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <a class="not-found__link" href="/sillas-ergonomicas">Volver al inicio</a>
  </section>
</BaseLayout>

<style lang="scss">
  .not-found {
    @include section;
    @include container("text");

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .not-found__code {
    @include mono-label;

    color: color("cobalt");
  }

  .not-found__title {
    @include h1-page;
  }

  .not-found__text {
    @include body-text;
  }

  .not-found__link {
    @include pill;
  }
</style>
