---
import type { ImageMetadata } from 'astro';
import type { Thing } from 'schema-dts';
import { Font } from 'astro:assets';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Seo from '@/components/seo/Seo.astro';
import { site } from '@/data/site';
import { organization, website } from '@/lib/schema';
import '@/styles/global.scss';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica de la página, p. ej. `/catalogo/malla`. */
  path: string;
  indexable?: boolean;
  /** JSON-LD propio de la página; Organization y WebSite se añaden siempre. */
  jsonLd?: readonly Thing[];
  /** Imagen de vista previa al compartir (og:image). */
  image?: { readonly src: ImageMetadata; readonly alt: string } | undefined;
  /** Scroll por pantallas: cada bloque de `main` es un punto de anclaje (ver global.scss). */
  snapSections?: boolean;
}

const { title, description, path, indexable = true, jsonLd = [], image, snapSections = false } = Astro.props;

const globalJsonLd = [
  organization({
    name: site.name,
    url: site.url,
    email: site.contact.email,
    phone: site.contact.whatsapp,
    description: site.tagline,
    // PENDIENTE (operacion.md, H3): sustituir por el logo definitivo en PNG cuadrado ≥ 112 px.
    logo: new URL('/favicon.svg', site.url).href,
  }),
  website(site.name, site.url, site.market.locale),
];
---

<!doctype html>
<html lang={site.market.locale} data-snap-sections={snapSections ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Marca que hay JS antes del primer pintado: el CSS colapsa el menú móvil desde el
      principio en vez de hacerlo el script al cargar, que movería toda la página (CLS).
    -->
    <script is:inline>
      document.documentElement.dataset.js = '';
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-archivo" preload={[{ weight: 700, style: 'normal' }]} />
    <Font cssVariable="--font-newsreader" />
    <Font cssVariable="--font-mono" />
    <Seo title={title} description={description} path={path} indexable={indexable} image={image} />
    <JsonLd data={[...globalJsonLd, ...jsonLd]} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
