---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { framingStyle, type Framing } from '@/lib/framing';

interface Props {
  src: ImageMetadata;
  alt: string;
  framing: Framing;
  /** Anchos a generar (px reales, ya con la densidad 2x incluida). */
  widths: number[];
  sizes?: string;
  class?: string;
  priority?: boolean;
}

// Acepta fotos de cualquier proporción: se generan con la suya (sin recorte en el build)
// y el componente que la usa pone el marco con CSS (`aspect-ratio` u `height`).
// `rest` lleva el atributo de scope (data-astro-cid-*) del componente padre: sin él, sus
// estilos de la clase no llegarían al <img>.
const { src, alt, framing, widths, sizes, class: className, priority = false, ...rest } = Astro.props;
const availableWidths = widths.filter((width) => width <= src.width);
const maxWidth = Math.min(Math.max(...widths), src.width);
---

<Picture
  class={className}
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  width={maxWidth}
  widths={availableWidths.length > 0 ? availableWidths : [maxWidth]}
  sizes={sizes}
  style={framingStyle(framing)}
  priority={priority}
  {...rest}
/>
