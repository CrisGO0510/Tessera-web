---
import Photo from '@/components/ui/Photo.astro';
import { site } from '@/data/site';
import { themeGradient, type Chair } from '@/lib/content';

interface Props {
  /** `featured.hero`: la validación de contenido garantiza que todas tienen `theme`. */
  chairs: readonly Chair[];
}

const { chairs } = Astro.props;
const first = chairs[0];
if (first === undefined) {
  throw new Error('La portada necesita al menos una silla (featured.hero).');
}

function chairLink(chair: Chair): string {
  return `/catalogo#${chair.id}`;
}

// Cada grupo de la marquesina repite las sillas hasta pasar del ancho de un monitor grande
// (tarjeta de 176 px + 26 px de hueco): con pocas sillas, un solo pase dejaba media pista vacía.
const CARD_WIDTH = 202;
const WIDTH_TO_COVER = 2560;
const passes = Math.max(1, Math.ceil(WIDTH_TO_COVER / (CARD_WIDTH * chairs.length)));

---

<section id="inicio" class="hero">
  <ts-hero class="hero__frame" data-autoplay={String(site.heroAutoplay)}>
    {
      chairs.map((chair, i) => (
        <div class="hero__background" data-hero-background data-active={i === 0 ? '' : undefined} style={`background: ${themeGradient(chair)}`} />
      ))
    }

    <div class="hero__word" aria-hidden="true">ERGONÓMICAS</div>

    <div class="marquee">
      <div class="marquee__track">
        {
          [false, true].map((isCopy) => (
            <div class="marquee__group" aria-hidden={isCopy ? 'true' : undefined} inert={isCopy}>
              {Array.from({ length: passes }, (_, passIndex) => (
                // Solo el primer pase del primer grupo se lee y se tabula; el resto es relleno visual.
                <div class="marquee__pass" aria-hidden={!isCopy && passIndex > 0 ? 'true' : undefined} inert={!isCopy && passIndex > 0}>
                  {chairs.map((chair) => (
                    <a class="marquee__card" href={chairLink(chair)}>
                      <Photo
                        class="marquee__image"
                        src={chair.data.image.src}
                        alt={isCopy || passIndex > 0 ? '' : chair.data.image.alt}
                        framing={chair.data.image}
                        widths={[308]}
                        sizes="154px"
                      />
                      <span class="marquee__name">{chair.data.name}</span>
                      <span class="marquee__summary">{chair.data.summary}</span>
                    </a>
                  ))}
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <h1 class="hero__title">Sillas ergonómicas para <span class="hero__emphasis">home office</span></h1>

    <div class="hero__images" data-hero-pause>
      {
        chairs.map((chair, i) => (
          <div class="hero__image" data-hero-image data-active={i === 0 ? '' : undefined} aria-hidden={i === 0 ? undefined : 'true'}>
            <Photo
              class="hero__photo"
              src={chair.data.image.src}
              alt={chair.data.image.alt}
              framing={chair.data.image}
              widths={[400, 800]}
              sizes="min(400px, 78vw)"
              priority={i === 0}
            />
          </div>
        ))
      }
    </div>

    <div class="hero__controls" data-hero-pause>
      <div class="hero__chip">
        <span class="hero__chip-text">
          <span class="hero__chip-name" data-hero-name>{first.data.name}</span>
          <span class="hero__chip-summary" data-hero-summary>{first.data.summary}</span>
        </span>
        <a class="hero__chip-link" href={chairLink(first)} data-hero-link>Ver la silla</a>
      </div>
      {
        chairs.length > 1 && (
          <div class="hero__dots">
            {chairs.map((chair, i) => (
              <button
                type="button"
                class="hero__dot"
                data-hero-dot
                aria-label={chair.data.name}
                aria-pressed={i === 0 ? 'true' : 'false'}
                data-name={chair.data.name}
                data-summary={chair.data.summary}
                data-href={chairLink(chair)}
              />
            ))}
          </div>
        )
      }
    </div>

    <a class="hero__next" href="#necesidades">
      <span class="hero__next-text">Sigue</span>
      <svg width="16" height="18" viewBox="0 0 16 18" fill="none" aria-hidden="true">
        <path d="M8 1v14M2.5 9.5L8 15.5l5.5-6" stroke="currentcolor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </ts-hero>
</section>

<script>
  import { registerHero } from '@/scripts/hero';

  registerHero();
</script>

<style lang="scss">
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero__frame {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: min(88vh, 760px);
    padding: 56px $side-padding 96px;

    // Por pantallas, la portada y la barra de categorías forman la primera pantalla.
    @include in-snap-sections {
      min-height: calc(100svh - var(--header-height) - #{$category-bar-height});
      padding-block: 56px clamp(56px, 9svh, 96px);
    }
  }

  // El gradiente no se puede interpolar: cada silla tiene su capa y se funde la opacidad.
  .hero__background {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.7s ease;

    &[data-active] {
      opacity: 1;
    }
  }

  .hero__word {
    position: absolute;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    font: 700 clamp(18px, 3.4vw, 30px) / 1 font("archivo");
    letter-spacing: 0.36em;
    color: ink(13%);
    white-space: nowrap;
    pointer-events: none;
  }

  .marquee {
    position: absolute;
    top: 26%;
    right: 0;
    left: 0;
    display: flex;

    // Pegada a la izquierda: centrada, el ciclo de -50 % a 0 dejaba vacía media pantalla.
    justify-content: flex-start;
    pointer-events: none;
    opacity: 0.95;

    // Con la portada a una pantalla el título queda más arriba: la pista baja para no cruzarlo.
    @include in-snap-sections {
      top: 36%;
    }
  }

  .marquee__track {
    display: flex;
    width: max-content;
    pointer-events: auto;
    animation: ts-slide 38s linear infinite;

    // Pausa con el ratón y con el teclado (una tarjeta enfocada no debe escaparse).
    &:hover,
    &:focus-within {
      animation-play-state: paused;
    }

    @include reduced-motion {
      animation: none;
    }
  }

  // Cada grupo lleva su propio espacio final: así la pista mide exactamente dos grupos
  // y el bucle de -50 % a 0 no tiene costura.
  .marquee__group {
    display: flex;
    gap: 26px;
    padding-right: 26px;
  }

  // Sin caja propia: las tarjetas de todos los pases comparten el `gap` del grupo.
  .marquee__pass {
    display: contents;
  }

  .marquee__card {
    flex: none;
    width: 176px;
    padding: 11px;
    border-radius: radius("l");
    background: rgb(255 255 255 / 88%);
    box-shadow: shadow("marquee");
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;

    &:hover {
      transform: translateY(-9px);
      box-shadow: shadow("marquee-hover");
    }
  }

  .marquee__image {
    width: 100%;
    height: 142px;
    border-radius: radius("xxs");
  }

  .marquee__name {
    display: block;
    margin-top: 10px;
    font: 600 12.5px / 1.3 font("archivo");
    color: color("ink");
  }

  .marquee__summary {
    display: block;
    margin-top: 5px;
    font: 400 10.5px / 1 font("mono");
    color: color("gray-mid");
  }

  .hero__title {
    @include h1;

    position: relative;
    z-index: 2;
    max-width: 19ch;
    margin: 0 0 26px;
    text-align: center;

    @include in-snap-sections {
      margin-bottom: clamp(12px, 2.5svh, 26px);
    }
  }

  .hero__emphasis {
    @include serif-emphasis;
  }

  .hero__images {
    position: relative;
    z-index: 2;
    width: min(400px, 78vw);
    aspect-ratio: 1 / 1;
    overflow: hidden;

    // Fondo propio: una foto recortada (PNG transparente) no debe dejar ver la marquesina.
    background: color("ice-alt");
    border-radius: radius("hero");
    box-shadow: shadow("hero");

    @include in-snap-sections {
      width: min(400px, 78vw, 34svh);
    }
  }

  .hero__image {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 0.7s ease,
      transform 0.9s ease;

    &[data-active] {
      opacity: 1;
      transform: scale(1);
    }
  }

  // <Picture> renderiza <picture><img>: la clase va al <img>.
  .hero__photo {
    width: 100%;
    height: 100%;
  }

  .hero__controls {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: -30px;
  }

  .hero__chip {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 10px 10px 20px;
    border-radius: radius("pill");
    background: rgb(255 255 255 / 92%);
    box-shadow: shadow("chip");
  }

  .hero__chip-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .hero__chip-name {
    font: 600 14.5px / 1 font("archivo");
    color: color("ink");
  }

  .hero__chip-summary {
    font: 400 10.5px / 1 font("mono");
    color: color("gray-mid");
  }

  .hero__chip-link {
    padding: 10px 16px;
    border-radius: radius("pill");
    background: color("cobalt");
    color: color("white");
    font: 600 12.5px / 1 font("archivo");

    &:hover {
      color: color("white");
      filter: brightness(1.1);
    }
  }

  .hero__dots {
    display: flex;
    gap: 7px;
  }

  // Indicadores a 33 px entre centros (26 px + 7 px): el área cubre 44 px en vertical y
  // todo el paso en horizontal; los 44 px en horizontal exigirían separarlos más.
  .hero__dot {
    @include touch-target(44px, 33px);

    display: block;
    width: 26px;
    height: 5px;
    padding: 0;
    border: 0;
    border-radius: 3px;
    background: ink(22%);
    cursor: pointer;
    transition: background 0.3s ease;

    &[aria-pressed="true"] {
      background: color("cobalt");
    }
  }

  .hero__next {
    position: absolute;
    bottom: 18px;
    left: 50%;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    color: color("ink");
    transform: translateX(-50%);
    animation: ts-nudge 1.9s ease-in-out infinite;

    &:hover {
      color: color("ink");
    }

    @include reduced-motion {
      animation: none;
    }
  }

  .hero__next-text {
    font: 500 9.5px / 1 font("mono");
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: ink(65%);
  }

  @keyframes ts-slide {
    from {
      transform: translateX(-50%);
    }

    to {
      transform: translateX(0);
    }
  }

  @keyframes ts-nudge {
    0%,
    100% {
      opacity: 0.75;
      transform: translateX(-50%) translateY(0);
    }

    50% {
      opacity: 1;
      transform: translateX(-50%) translateY(7px);
    }
  }
</style>
