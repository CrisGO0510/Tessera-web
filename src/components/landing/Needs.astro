---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { categoryPath } from '@/lib/catalog';
import type { ResolvedNeed } from '@/lib/content';

interface Props {
  needs: readonly ResolvedNeed[];
}

const { needs } = Astro.props;
---

<section id="necesidades" class="needs">
  <div class="needs__content">
    <SectionHeading
      label="Empieza por lo que te pasa"
      title="¿Qué buscas resolver?"
      intro="No hace falta saber de mecanismos. Dinos qué te molesta al trabajar y te llevamos a las sillas que resuelven ese caso."
    />
    <div class="needs__grid">
      {
        needs.map(({ entry, category }) => (
          <a class="need" href={categoryPath(category.data.slug)} data-need={entry.id}>
            <span class="need__label">{entry.data.label}</span>
            <span class="need__title">{entry.data.title}</span>
            <span class="need__description">{entry.data.description}</span>
            <span class="need__cta">{entry.data.cta} →</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  .needs {
    @include section;

    background: color("ice");
  }

  .needs__content {
    @include container;

    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .needs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 16px;
  }

  .need {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 24px;
    border: 1px solid ink(8%);
    border-radius: radius("m");
    background: color("white");
    box-shadow: shadow("rest");
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;

    &:hover {
      border-color: rgb(46 91 219 / 25%);
      box-shadow: shadow("need-hover");
      transform: translateY(-4px);
    }

    @include reduced-motion {
      &:hover {
        transform: none;
      }
    }
  }

  .need__label {
    @include mono-label(9.5px);

    color: color("cobalt");
  }

  .need__title {
    font: 600 19px / 1.22 font("archivo");
    letter-spacing: -0.02em;
    color: color("ink");
    text-wrap: pretty;
  }

  .need__description {
    @include body-text(13.5px, 1.6);

    color: color("gray-mid");
  }

  .need__cta {
    margin-top: auto;
    padding-top: 14px;
    font: 600 12.5px / 1 font("archivo");
    color: color("cobalt");
  }
</style>
