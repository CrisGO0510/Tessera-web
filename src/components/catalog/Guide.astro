---
import DarkBanner from '@/components/ui/DarkBanner.astro';
import type { Category } from '@/lib/content';

interface Props {
  guide: Category['data']['guide'];
  /** Texto de la franja hacia el comparador (`comparisonBanner()`). */
  banner: string;
}

const { guide, banner } = Astro.props;
const { title, paragraphs, sections } = guide;
---

<section class="guide" id="cat-guia">
  <div class="guide__content">
    <h2 class="guide__title">{title}</h2>
    <div class="guide__columns">
      <div class="guide__column">
        {paragraphs.map((paragraph) => <p class="guide__paragraph">{paragraph}</p>)}
      </div>
      {
        sections.length > 0 && (
          <div class="guide__column">
            {sections.map((section) => (
              <>
                <h3 class="guide__subtitle">{section.title}</h3>
                <p class="guide__paragraph">{section.text}</p>
              </>
            ))}
          </div>
        )
      }
    </div>
    <DarkBanner text={banner} link={{ text: 'Abrir el comparador', href: '/comparar' }} />
  </div>
</section>

<style lang="scss">
  .guide {
    @include section-compact;

    background: color("ice");
  }

  .guide__content {
    @include container("text");

    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .guide__title {
    max-width: 24ch;
    margin: 0;
    font: 700 clamp(26px, 3.4vw, 40px) / 1.06 font("archivo");
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .guide__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 28px;
  }

  .guide__column {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .guide__paragraph {
    @include body-text(14.5px, 1.75);
  }

  .guide__subtitle {
    margin: 0;
    font: 600 17px / 1.3 font("archivo");
    letter-spacing: -0.02em;
    color: color("ink");
  }
</style>
