---
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import type { VisibleBreadcrumb } from '@/lib/breadcrumbs';
import type { Category } from '@/lib/content';

interface Props {
  breadcrumbs: readonly VisibleBreadcrumb[];
  title: Category['data']['title'];
  intro: string;
  /** Sillas visibles al cargar (la faceta o todas). */
  visible: number;
  total: number;
}

const { breadcrumbs, title, intro, visible, total } = Astro.props;
---

<section class="catalog-header" id="cat-cabecera">
  <div class="catalog-header__content">
    <Breadcrumbs items={breadcrumbs} />
    <div class="catalog-header__row">
      <div class="catalog-header__text">
        <h1 class="catalog-header__title">
          {title.text}{title.emphasis !== undefined && ' '}
          {title.emphasis !== undefined && <span class="catalog-header__emphasis">{title.emphasis}</span>}
        </h1>
        <p class="catalog-header__intro">{intro}</p>
      </div>
      <div class="catalog-header__status">
        <span class="catalog-header__count"><span data-visible-count>{visible}</span> de {total} sillas</span>
        <span class="catalog-header__separator" aria-hidden="true"></span>
        <span class="catalog-header__order">orden: recomendadas</span>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .catalog-header {
    padding: clamp(40px, 5vw, 68px) $side-padding clamp(32px, 4vw, 52px);
    background: color("ice");
  }

  .catalog-header__content {
    @include container;

    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .catalog-header__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
  }

  .catalog-header__text {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 58ch;
  }

  .catalog-header__title {
    @include h1-page;
  }

  .catalog-header__emphasis {
    @include serif-emphasis;
  }

  .catalog-header__intro {
    @include body-text;
  }

  .catalog-header__status {
    display: flex;
    flex: none;
    align-items: center;
    gap: 14px;
    padding: 12px 18px;
    border: 1px solid ink(8%);
    border-radius: radius("xs");
    background: color("white");
  }

  .catalog-header__count {
    font: 400 11px / 1 font("mono");
    color: color("gray-mid");
  }

  .catalog-header__separator {
    width: 1px;
    height: 16px;
    background: ink(13%);
  }

  .catalog-header__order {
    font: 500 11px / 1 font("mono");
    color: color("ink");
  }
</style>
