---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { site } from '@/data/site';
import { canonicalUrl, openGraphLocale, pageTitle } from '@/lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  indexable: boolean;
  /** Vista previa al compartir (WhatsApp, redes): la foto entera sobre fondo ice, 1200×630. */
  image?: { readonly src: ImageMetadata; readonly alt: string } | undefined;
}

const { title, description, path, indexable, image } = Astro.props;
const fullTitle = pageTitle(title, site.name);
const canonical = canonicalUrl(site.url, path);
const OG_SIZE = { width: 1200, height: 630 };
const ogImage =
  image === undefined
    ? undefined
    : await getImage({ src: image.src, width: OG_SIZE.width, height: OG_SIZE.height, fit: 'contain', background: '#eef2fb', format: 'jpg' });
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{/* Una página noindex (la 404) no declara canonical: no hay versión preferida que indexar. */}
{indexable && <link rel="canonical" href={canonical} />}
{!indexable && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={openGraphLocale(site.market.locale)} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{
  ogImage !== undefined && image !== undefined && (
    <>
      <meta property="og:image" content={new URL(ogImage.src, site.url).href} />
      <meta property="og:image:width" content={String(OG_SIZE.width)} />
      <meta property="og:image:height" content={String(OG_SIZE.height)} />
      <meta property="og:image:alt" content={image.alt} />
    </>
  )
}
<meta name="twitter:card" content={ogImage === undefined ? 'summary' : 'summary_large_image'} />
